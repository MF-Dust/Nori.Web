{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nori-web",
  "main": "cloudflare/entry.py",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "preview_urls": true,
  "base_dir": "./cloudflare",
  "find_additional_modules": true,
  "rules": [
    {
      "type": "Text",
      "globs": [
        "backend/data/codenames_words.json",
        "backend/data/pictionary_words.json"
      ],
      "fallthrough": false
    },
    {
      "type": "Data",
      "globs": ["__nori_no_data_modules__"],
      "fallthrough": false
    },
    {
      "type": "CompiledWasm",
      "globs": ["__nori_no_wasm_modules__"],
      "fallthrough": false
    }
  ],
  "build": {
    "command": "uv run python scripts/prepare_cloudflare_runtime.py",
    "cwd": "."
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "placement": {
    "mode": "smart"
  },
  // Domains and routing are intentionally managed in the Cloudflare dashboard.
  // Keep route configuration absent here so Wrangler deploys do not overwrite it.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/datasea/cosmicweb.min.glb"
    ]
  },
  "r2_buckets": [
    {
      "binding": "NORI_ASSETS_R2",
      "bucket_name": "nori-web-assets"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NORI_ARCADE",
        "class_name": "NoriArcadeSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NoriArcadeSession"]
    }
  ],
  "vars": {
    "NORI_DISABLE_LIVE_PACK": "0"
  },
  "python_modules": {
    "excludes": ["**/*.pyc", "**/__pycache__"]
  }
}
