{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nori-web",
  "main": "rust/crates/nori-worker/build/worker/shim.mjs",
  "compatibility_date": "2026-08-28",
  "workers_dev": false,
  "preview_urls": true,
  "build": {
    "command": "worker-build --release",
    "cwd": "rust/crates/nori-worker"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "placement": {
    "mode": "smart"
  },
  // Domains and routing are intentionally managed in the Cloudflare dashboard.
  // Keep route configuration absent here so Wrangler deploys do not overwrite it.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/datasea/cosmicweb.min.glb"
    ]
  },
  "r2_buckets": [
    {
      "binding": "NORI_ASSETS_R2",
      "bucket_name": "nori-web-assets"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NORI_ARCADE",
        "class_name": "NoriArcadeSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NoriArcadeSession"]
    }
  ],
  "vars": {
    "NORI_DISABLE_LIVE_PACK": "0"
  }
}
