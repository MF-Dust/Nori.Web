{
  "name": "nori-os-local-compatibility",
  "version": "2.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Local protocol-compatible backend for the publicly shipped NoriOS web client",
  "type": "module",
  "scripts": {
    "legal:refresh": "node scripts/refresh_legal_notices.mjs",
    "test:legal": "python -m unittest tests.test_release_legal",
    "start": "cargo run --release -p nori-local --manifest-path rust/Cargo.toml",
    "frontend:app:dev": "vite --config frontend-src/app.vite.config.ts",
    "frontend:app:build": "vite build --config frontend-src/app.vite.config.ts",
    "frontend:typecheck": "tsc -p frontend-src/tsconfig.json --noEmit",
    "test:rust": "cargo test --locked --workspace --manifest-path rust/Cargo.toml",
    "test:schema": "node tests/test_client_schema.mjs",
    "test:browser": "node tests/test_browser_bootstrap.mjs",
    "test": "npm run test:rust && npm run test:schema && npm run frontend:test && npm run test:browser && npm run frontend:story:boot",
    "frontend:test": "node scripts/test/run_node_tests.mjs all",
    "frontend:games:test": "node scripts/test/run_node_tests.mjs games",
    "frontend:games:smoke": "node scripts/smoke/smoke_frontend_games.mjs",
    "frontend:games:lifecycle": "node scripts/probes/frontend_games_lifecycle_test.mjs",
    "frontend:runtime:test": "node scripts/test/run_node_tests.mjs runtime",
    "frontend:app:smoke": "node scripts/smoke/smoke_frontend_app.mjs",
    "frontend:stories:test": "node scripts/test/run_node_tests.mjs stories",
    "frontend:story:boot": "node tests/test_source_story_bootstrap.mjs",
    "frontend:ai:smoke": "node tests/test_source_ai_features.mjs",
    "frontend:stories:smoke": "node scripts/smoke/smoke_frontend_stories.mjs",
    "frontend:ownership:test": "node --test tests/frontend/frontend-asset-ownership.test.mjs",
    "frontend:cutover:candidate": "node scripts/recovery/prepare_frontend_cutover_candidate.mjs",
    "frontend:cutover:smoke": "node scripts/smoke/smoke_frontend_candidate.mjs",
    "frontend:visual:reference": "node scripts/probes/frontend_visual_reference_probe.mjs",
    "frontend:visual:games": "node scripts/probes/frontend_visual_games_probe.mjs",
    "frontend:suites:test": "node scripts/test/run_node_tests.mjs suites"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.12",
    "js-beautify": "^2.0.3",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "wrangler": "4.147.0"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.2.7",
    "@xterm/xterm": "^5.5.0",
    "chess.js": "1.4.0",
    "lucide-react": "^0.475.0",
    "pdfjs-dist": "5.4.624",
    "pixi.js": "8.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.5",
    "three": "0.180.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  }
}
