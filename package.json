{
  "name": "nori-os-local-compatibility",
  "version": "2.0.0",
  "private": true,
  "description": "Local protocol-compatible backend for the publicly shipped NoriOS web client",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "python server.py",
    "start:py": "python server.py",
    "frontend:build": "vite build --config frontend-src/vite.config.ts",
    "frontend:app:dev": "vite --config frontend-src/app.vite.config.ts",
    "frontend:app:build": "vite build --config frontend-src/app.vite.config.ts",
    "frontend:cutover:check": "node scripts/verify_frontend_cutover.mjs",
    "frontend:inspect:normalapp": "node scripts/inspect_frontend_chunk.mjs NormalApp-",
    "frontend:inspect:identifier": "node scripts/inspect_frontend_identifier.mjs",
    "frontend:recover": "node scripts/run_frontend_recovery.mjs",
    "frontend:recover:check": "node scripts/verify_frontend_recovery.mjs",
    "frontend:typecheck": "tsc -p frontend-src/tsconfig.json --noEmit",
    "test:cartridges": "python tests/test_cartridges.py",
    "test:backend": "python tests/test_backend_integration.py",
    "test:virtual_apps": "python tests/test_virtual_apps.py",
    "test:ai": "python tests/test_ai_runtime_settings.py",
    "test:tts": "python tests/test_tts_runtime_settings.py",
    "test:schema": "node tests/test_client_schema.mjs",
    "test:browser": "node tests/test_browser_bootstrap.mjs",
    "test:perf": "python tests/test_performance_optimizations.py",
    "test": "npm run test:cartridges && npm run test:virtual_apps && npm run test:schema && npm run test:backend && npm run test:ai && npm run test:tts && npm run test:perf && npm run test:browser"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "js-beautify": "^2.0.3",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@xterm/xterm": "^5.5.0",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.475.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.5",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  }
}
